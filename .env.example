# =========================================================
# REQUIRED CONFIGURATION
# =========================================================

# Groq API Key (Required for LLM - LLaMA 3.3 70B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Connection String (Required for LangGraph Checkpointer)
# Can be local PostgreSQL or a free cloud DB (Neon.tech, Supabase, Render)
# Format: postgresql://username:password@host:port/database_name?sslmode=require
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require


# =========================================================
# OPTIONAL API KEYS (Specialist Agents have fallbacks if omitted)
# =========================================================

# Tavily API Key (Used by Hotel Agent for web search)
# Get a key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeatherMap API Key (Used by Weather Agent)
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AviationStack API Key (Used by Flight Agent)
# Get a free key at: https://aviationstack.com
AVIATION_STACK_API_KEY=your_aviationstack_api_key_here
